# =============================================================================
# Environment variables — TableOrder / Next.js
# =============================================================================
# Copy to `.env` in the project root and replace placeholders.
# Never commit real API keys. `.env` should be gitignored.
# Docs: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
# =============================================================================

# Public site URL (metadata, Open Graph). Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Web App config (Firebase Console → Project settings → Your apps)
# These names are safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef
# Optional — Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Realtime Database (Console → Build → Realtime Database → copy URL)
# Required for live guest orders + owner “Live orders” page. Deploy rules from firebase/database.rules.json
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
# Optional server-only override (same URL is fine)
# FIREBASE_DATABASE_URL=

# -----------------------------------------------------------------------------
# Server-only (Admin SDK, never use in Client Components — no NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Option A — entire service-account JSON on ONE line (easiest on Vercel / CI):
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
# Alias: FIREBASE_SERVICE_ACCOUNT_JSON=...
#
# Option A2 — path to the downloaded JSON (local dev on Windows/macOS/Linux):
# GOOGLE_APPLICATION_CREDENTIALS=D:\path\to\serviceAccount.json
#
# Option B — split fields (private key must be PEM; use \n for line breaks in .env):
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
